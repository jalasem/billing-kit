# Postgres connection string. Docker Compose exposes the local instance on 5433; use the pooled Neon URL in production.
DATABASE_URL=postgres://billing:billing@localhost:5433/billing_kit
# Shared secret the api/cron/* routes require as `Authorization: Bearer <value>`; generate with `openssl rand -hex 32`.
CRON_SECRET=
# Stripe secret key (sk_test_... locally, sk_live_... in production). Leave unset to run with the fake provider only.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (whsec_...), from the Stripe dashboard or `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Paystack secret key (sk_test_... locally, sk_live_... in production). Leave unset to run with the fake provider only.
PAYSTACK_SECRET_KEY=
# Resend API key for dunning/notification emails; unset falls back to the console notifier (prints to stdout).
RESEND_API_KEY=
# "From" address for dunning notification emails when RESEND_API_KEY is set; defaults to billing@example.com.
RESEND_FROM=
# Base URL used to build magic-link callback URLs (src/core/auth/magic-link.ts); defaults to http://localhost:3000.
APP_URL=http://localhost:3000
# Comma-separated emails granted an operator (admin) session on login. No SESSION_SECRET is needed —
# sessions are opaque, database-backed ids in an httpOnly cookie, not signed tokens. `pnpm seed` uses the
# first of these (default operator@example.com) as the demo operator login.
OPERATOR_EMAILS=operator@example.com
# Test-only: when "1", magic-link URLs are written to e2e/.auth/ instead of sent, so Playwright can read them
# without a mailbox. Read by src/core/notify/default.ts. Leave unset — NEVER set this in production, it would
# let anyone read another user's login link from disk.
E2E_TOKEN_SINK=
