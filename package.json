{
  "name": "billing-kit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/db-reset.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44",
    "next": "^15.3",
    "postgres": "^3.4",
    "react": "^19.1",
    "react-dom": "^19.1",
    "stripe": "^18.5.0",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55",
    "@tailwindcss/postcss": "^4.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "eslint-config-next": "^15.3",
    "eslint-plugin-react-hooks": "^5.0",
    "tailwindcss": "^4.1",
    "tsx": "^4.23",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
